# ─── Database ──────────────────────────────────────────
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Auth (NextAuth v5) ────────────────────────────────
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Groq (AI Quiz Generation) ────────────────────────
# Dashboard: https://console.groq.com → API Keys
GROQ_API_KEY=

# ─── AWS S3 (File Storage) ────────────────────────────
# Note: AWS_ prefix is reserved by Amplify — use S3_ prefix instead
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET_NAME=quiznex-uploads
# Optional: CloudFront CDN URL (e.g. https://d1234abcd.cloudfront.net)
S3_CLOUDFRONT_URL=

# ─── Google OAuth (optional — for Sign in with Google) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email (Gmail App Password) ───────────────────────
EMAIL_APP_PASSWORD=
EMAIL_FROM=noreply@yourdomain.com

# ─── App ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Sentry (Error Monitoring — optional) ─────────────
# Create project at sentry.io → Settings → Client Keys → DSN
NEXT_PUBLIC_SENTRY_DSN=
# Required for source map uploads during build (get from sentry.io → Settings → Auth Tokens)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Safepay (Payments) ────────────────────────────────
# Dashboard: https://getsafepay.com/dashboard  (sandbox: https://sandbox.api.getsafepay.com/dashboard/login)
# Developers → API Keys
SAFEPAY_SECRET_KEY=
SAFEPAY_PUBLIC_KEY=
# Developers → Endpoints → "View shared secret" (for webhook HMAC verification)
SAFEPAY_WEBHOOK_SECRET=
# "sandbox" or "production"
SAFEPAY_ENV=sandbox
